# Copy to .env on the server (never commit .env). Restart pm2 after changing.

# --- email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Optional. Defaults to Resend's shared sender; switch once trufflinnovations.in
# is verified as a sending domain in Resend.
MAIL_FROM=Truffl <hello@trufflinnovations.in>
# Where contact / request-access submissions are emailed.
NOTIFY_EMAIL=as@trufflinnovations.in

# --- signing ----------------------------------------------------------------
# Signs the approval links in the notification email. openssl rand -hex 32
AUTH_TOKEN_SECRET=

# --- Slack ------------------------------------------------------------------
# api.slack.com/apps -> your app -> Incoming Webhooks -> Add New Webhook.
# Without it, notifications are logged only.
SLACK_WEBHOOK_URL=

# --- Calendly ---------------------------------------------------------------
# The scheduling link the site embeds. Without it the booking step shows an
# "email us instead" fallback.
CALENDLY_EVENT_URL=
# The id of the "Company" question on that event type, for prefilling (a1, a2...).
CALENDLY_COMPANY_QUESTION=a1
# Printed by scripts/register-calendly-webhook.js. Deliveries are rejected
# without it, which is the safe default.
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- builder app hand-off ---------------------------------------------------
# Where every credential route sends visitors.
TRUFFL_AUTH_ORIGIN=https://build.trufflinnovations.in
SITE_ORIGIN=https://trufflinnovations.in
# Set once the builder app exposes its invite endpoint (see the login issue on
# aatithyapersonal/Truffl). Until then approval is recorded and you invite by
# hand from Supabase Auth.
TRUFFL_BUILD_INVITE_URL=
TRUFFL_BUILD_INVITE_SECRET=

# --- storage ----------------------------------------------------------------
# Where submissions are written. Defaults to .data/ inside the repo.
TRUFFL_DATA_DIR=
